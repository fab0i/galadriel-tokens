{
  "name": "galadriel-tokens",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "pages:deploy": "pnpm build && wrangler pages deploy",
    "pages:deploy:preview": "pnpm build && wrangler pages deploy --branch preview",
    "test": "vitest run",
    "default-tokens": "node scripts/default-tokens.ts"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
